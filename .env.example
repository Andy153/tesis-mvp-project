# Clerk (https://dashboard.clerk.com) — obligatorio para auth y middleware
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

OPENAI_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ARCA / AFIP (afipsdk.com)
AFIP_SDK_ACCESS_TOKEN=
AFIP_CERT_PATH=certs/traza_homo.crt
AFIP_KEY_PATH=certs/traza_homo.key
AFIP_WSAA_CA_PATH=certs/wsaa_homo_ca.cer
AFIP_CUIT=23452350319
AFIP_PUNTO_VENTA=10
# desarrollo = homologación AFIP · produccion = comprobantes reales
AFIP_AMBIENTE=desarrollo
AFIP_RAZON_SOCIAL=

# Receptor fijo del wizard de cobros (MVP). El servidor lo usa al emitir.
FACTURA_RECEPTOR_CUIT=23452350319
FACTURA_RECEPTOR_RAZON_SOCIAL=Andres Garcia Skinner

# Vercel Cron — mismo valor en Vercel → Settings → Environment Variables (Vercel lo manda como Authorization: Bearer …)
CRON_SECRET=

# Web Push (PWA) — generar con: npx web-push generate-vapid-keys
# La pública va en build (NEXT_PUBLIC_*); la privada solo servidor (obligatoria para enviar push desde cron/API).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: mailto:tu@email.com o https://tu-dominio.com
VAPID_SUBJECT=mailto:soporte@traza.app

